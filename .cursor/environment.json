{
  // Cursor Cloud Agent environment (https://cursor.com/docs/cloud-agent/setup)
  // Runtime: bun. Bun is installed in `install` when this repo uses it.
  // Secrets cannot live in this file — add names below in the Cursor dashboard Secrets tab.
  // CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN, DATABASE_ID, KV_NAMESPACE_ID, EMAIL_API_KEY, NOTIFICATION_EMAIL
  "name": "memory-server",
  "install": "export BUN_INSTALL=\"$HOME/.bun\"; export PATH=\"$BUN_INSTALL/bin:$PATH\"; command -v bun >/dev/null 2>&1 || curl -fsSL https://bun.sh/install | bash; export PATH=\"$HOME/.bun/bin:$PATH\" && bun install && (cd ui && (npm ci || npm install) || true)",
  "start": "export BUN_INSTALL=\"$HOME/.bun\"; export PATH=\"$BUN_INSTALL/bin:$PATH\"; bunx wrangler d1 migrations apply memory-db --local && bun run dev",
  "ports": [
    {
      "name": "worker",
      "port": 8787
    }
  ]
}
